# Copy to .env and fill in. .env is git-ignored; never commit the real key.
# Use one provider. For a low-cost local run, set the DeepSeek key only.
DEEPSEEK_API_KEY=sk-...
# LLM_PROVIDER=deepseek
# DEEPSEEK_MODEL_DEFAULT=deepseek-flash
# DEEPSEEK_MODEL_QUICK=deepseek-flash
# DEEPSEEK_THINKING=disabled
# Alternative: OpenRouter
# OPENROUTER_API_KEY=sk-or-v1-...
# Optional: which OpenRouter models the "default" and "quick" tiers use
# OPENROUTER_MODEL_DEFAULT=anthropic/claude-sonnet-5.5
# OPENROUTER_MODEL_QUICK=anthropic/claude-haiku-5.5
# PORT=8787
